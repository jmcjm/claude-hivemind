#!/usr/bin/env bash
# hive — command a swarm of Claude Code agents in herdr.
# One drone = one herdr workspace = one pane with an interactive Claude Code (opus).
# Communication: brief in a file -> drone works -> report in a file. Zero TUI scraping.
set -uo pipefail

SKILL_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
HIVE_DIR="${HIVE_DIR:-$HOME/.herdr-hive}"
DRONES_DIR="$HIVE_DIR/drones"
MAIL_DIR="$HIVE_DIR/mail"
MODEL="${HIVE_MODEL:-opus}"
mkdir -p "$DRONES_DIR" "$MAIL_DIR"

die() { echo "hive: $*" >&2; exit 1; }
command -v herdr >/dev/null || die "herdr not found in PATH"

# --- helpers --------------------------------------------------------------

# Extracts a field from a herdr JSON response. Usage: jqp '<python path>' <<<"$json"
jqp() { python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
r=d.get('result',d)
$1" 2>/dev/null; }

# Returns text sitting in the drone's input field (last '>' line in the frame), empty when clean.
# CRITICAL: the prompt is shared with the human. If the user typed something and did not send it,
# our 'enter' would send THEIR text, and our message would glue itself onto their sentence.
prompt_pending() {
  local pane="$1"
  herdr pane read "$pane" --source visible --lines 60 --format ansi 2>/dev/null | python3 -c "
import re,sys
# Claude Code suggests ready-made prompts as ghost text rendered DIMMED (SGR 2).
# That is NOT user text — Enter does not send it. Real typed input is bright.
# Take the last prompt line and count only characters outside dim fragments.
SGR = re.compile(r'\x1b\[([0-9;]*)m')
def bright_text(raw):
    out, dim, pos = [], False, 0
    for m in SGR.finditer(raw):
        if not dim: out.append(raw[pos:m.start()])
        for c in (m.group(1) or '0').split(';'):
            if c == '2': dim = True
            elif c in ('0', '22', ''): dim = False
        pos = m.end()
    if not dim: out.append(raw[pos:])
    return ''.join(out)
last = ''
for raw in sys.stdin.read().splitlines():
    if SGR.sub('', raw).strip().startswith('❯'):
        last = bright_text(raw).strip().lstrip('❯').strip()
print(last)
" 2>/dev/null
}

# --- swarm mail -----------------------------------------------------------
# Mailbox = a directory of message files. No daemon, no MTA: writes are atomic (mv),
# and the recipient never polls the mailbox anyway — wake_recipient wakes them.

coord_pane() { cat "$HIVE_DIR/coord.pane" 2>/dev/null; }

mailbox_put() {  # mailbox_put <from> <to> <kind> <subject> <body>
  local from="$1" to="$2" kind="$3" subject="$4" body="$5"
  local box="$MAIL_DIR/$to"; mkdir -p "$box"
  local tmp; tmp=$(mktemp "$box/.tmp.XXXXXX") || return 1
  python3 -c "
import json,sys,time
tmp,frm,to,kind,subject,body = sys.argv[1:7]
json.dump({'ts':time.strftime('%Y-%m-%d %H:%M:%S'),'from':frm,'to':to,
           'kind':kind,'subject':subject,'body':body},
          open(tmp,'w'), ensure_ascii=False, indent=1)
" "$tmp" "$from" "$to" "$kind" "$subject" "$body" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$box/$(date +%s%N)-$from.json"
}

# Wakes the recipient by injecting a message into their prompt. Safeguards:
#  - only when the recipient's prompt is EMPTY (never overwrite a human's text)
#  - flock: two drones never write into one prompt at the same time
#  - marker: one wake-up per batch, until the recipient runs 'hive inbox'
wake_recipient() {
  local who="$1" pane=""
  if [ "$who" = coord ]; then pane=$(coord_pane); else pane=$(pane_of "$who" 2>/dev/null); fi
  [ -n "$pane" ] || return 0

  exec 9>"$HIVE_DIR/.wake-lock"
  flock -w 15 9 || return 0
  [ -f "$HIVE_DIR/.wake-$who" ] && return 0        # already woken, do not spam
  case "$(pane_status "$pane")" in dead|blocked) return 0 ;; esac
  [ -n "$(prompt_pending "$pane")" ] && return 0   # human is typing — leave it, mail can wait

  # herdr 0.8: agent prompt appends Enter itself and honors bracketed-paste; for a recipient
  # mid-turn Claude Code queues the message, and one stuck at a dialog is rejected (agent_blocked).
  herdr agent prompt "$pane" "HIVE-MAIL: new mail. Run: hive inbox" >/dev/null 2>&1 || return 0
  : > "$HIVE_DIR/.wake-$who"
}

drone_dir()  { echo "$DRONES_DIR/$1"; }
drone_meta() { echo "$DRONES_DIR/$1/meta.json"; }

meta_get() {  # meta_get <drone> <key>
  [ -f "$(drone_meta "$1")" ] || return 1
  python3 -c "
import json,sys
print(json.load(open('$(drone_meta "$1")')).get('$2',''))" 2>/dev/null
}

pane_of() { meta_get "$1" pane_id; }

# Current pane status straight from herdr (idle|working|blocked|unknown|dead)
pane_status() {
  local pane="$1" out
  out=$(herdr pane get "$pane" 2>/dev/null) || { echo dead; return; }
  echo "$out" | jqp "p=r.get('pane',r); print(p.get('agent_status') or 'unknown')" || echo dead
}

# Is the pane stuck on a Claude Code dialog (trust / permission / choice)?
pane_dialog() {
  local pane="$1" txt
  txt=$(herdr pane read "$pane" --source visible --lines 30 2>/dev/null) || return 1
  case "$txt" in
    *"trust this folder"*)        echo trust ;;
    *"Yes, I accept"*)            echo consent ;;
    *"Do you want to proceed"*)   echo permission ;;
    *"requires approval"*)        echo permission ;;
    *) return 1 ;;
  esac
}

# --- commands -------------------------------------------------------------

cmd_spawn() {  # spawn <name> [--cwd PATH] [--resume]
  local name="${1:?usage: hive spawn <name> [--cwd PATH]}"; shift
  # herdr 0.8: the drone name doubles as the herdr agent name — [a-z][a-z0-9_-]{0,31} applies,
  # unique among live agents.
  [[ "$name" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] \
    || die "name '$name' rejected: herdr requires [a-z][a-z0-9_-]{0,31}"
  local cwd="$HOME" resume=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd) cwd="$2"; shift 2 ;;
      --resume) resume=1; shift ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [ -d "$cwd" ] || die "cwd does not exist: $cwd"

  local dir; dir=$(drone_dir "$name"); mkdir -p "$dir"
  local sid
  if [ "$resume" = 1 ] && sid=$(meta_get "$name" session_id) && [ -n "$sid" ]; then
    : # resuming an existing session
  else
    sid=$(python3 -c "import uuid;print(uuid.uuid4())")
    resume=0
  fi

  # Coordinator pane = the one hive was called from. Saved because mail to 'coord' lands there.
  # (herdr 0.8.2: --current resolves the CALLING pane, not the pane focused in another client)
  local coord; coord=$(herdr pane current --current 2>/dev/null | jqp "print(r['pane']['pane_id'])")
  [ -n "$coord" ] && echo "$coord" > "$HIVE_DIR/coord.pane"

  # 1 workspace per drone, label = drone name. Swarm environment variables enter here —
  # herdr 0.8 injects --env into the root pane shell, and agent start has no --env at all.
  local -a envs=(--env "HIVE_DRONE=$name" --env "HIVE_DIR=$HIVE_DIR" --env "HERDR_HIVE_ROLE=drone")
  [ -n "$coord" ] && envs+=(--env "HIVE_COORD_PANE=$coord")
  local ws_json ws pane
  ws_json=$(herdr workspace create --label "$name" --cwd "$cwd" --no-focus "${envs[@]}" 2>/dev/null) \
    || die "failed to create workspace"
  ws=$(jqp "print(r['workspace']['workspace_id'])" <<<"$ws_json")
  pane=$(jqp "print(r['root_pane']['pane_id'])" <<<"$ws_json")
  [ -n "$ws" ] && [ -n "$pane" ] || die "workspace create returned an incomplete response: $ws_json"

  # Swarm protocol lives in the system prompt, not in the brief — the drone knows it from
  # turn one and never loses it across tasks. The brief stays purely about the work.
  local sysprompt="You are drone '$name' in a swarm of agents run by a coordinator (another Claude Code).
The human does NOT read your terminal — only what you write to files and send counts.

Task report: write it to $dir/report.md (the brief gives the format). Without a report the task does not count.

Swarm mail (the 'hive' command, it is in PATH):
- send: hive send <recipient> '<subject>' --body '<text>'   (recipient: coord | drone name | all)
- read: hive inbox        (your mailbox; consumes messages)
- swarm: hive status      (who is alive and what they are working on)
When you see 'HIVE-MAIL' in your prompt — immediately run 'hive inbox' and handle its contents.
To talk to another drone use ONLY 'hive send'. Do not use 'hive say' or 'herdr' —
those are coordinator channels and you would corrupt the queue with them.

Report questions and blockers via 'hive send coord' — do not wait idly, nobody watches your panel."
  # herdr 0.8 cannot encode a multi-line argument for the target shell (invalid_agent_argument),
  # so the system prompt goes as a single line.
  sysprompt=$(printf '%s' "$sysprompt" | tr '\n' ' ' | tr -s ' ')

  local -a argv=(--dangerously-skip-permissions --model "$MODEL"
                 --settings "$SKILL_DIR/drone-settings.json"
                 --append-system-prompt "$sysprompt")
  if [ "$resume" = 1 ]; then argv+=(--resume "$sid"); else argv+=(--session-id "$sid"); fi

  # herdr 0.8: agent start targets an EXISTING pane (no splits, no orphaned shells)
  # and waits for agent readiness itself. On a startup dialog it returns agent_not_ready,
  # but the agent name stays live — the dialog is handled below.
  local start_out ready=0
  start_out=$(herdr agent start "$name" --kind claude --pane "$pane" --timeout 60000 \
                -- "${argv[@]}" 2>&1) && ready=1
  if [ "$ready" != 1 ]; then
    case "$start_out" in
      *agent_not_ready*) : ;;   # startup dialog — handled in the bootstrap below
      *) herdr workspace close "$ws" >/dev/null 2>&1
         die "failed to start the agent: $start_out" ;;
    esac
  fi

  python3 - "$dir" "$name" "$ws" "$pane" "$sid" "$cwd" <<'PY'
import json,sys
d,name,ws,pane,sid,cwd = sys.argv[1:7]
json.dump({"name":name,"workspace_id":ws,"pane_id":pane,"session_id":sid,"cwd":cwd},
          open(f"{d}/meta.json","w"), indent=1)
PY

  # Startup dialog bootstrap: the trust dialog appears despite --dangerously-skip-permissions
  # (for a new cwd), and the bypass consent on first skip-permissions use on a machine
  # (option 2 = "Yes, I accept"). herdr reports both as 'blocked'.
  local i
  for i in $(seq 1 12); do
    [ "$ready" = 1 ] && break
    case "$(pane_dialog "$pane" 2>/dev/null)" in
      trust)
        herdr agent send-keys "$name" enter >/dev/null 2>&1
        sleep 2 ;;
      consent)
        herdr pane send-text "$pane" 2 >/dev/null 2>&1
        sleep 1
        herdr agent send-keys "$name" enter >/dev/null 2>&1
        sleep 2 ;;
    esac
    herdr agent wait "$name" --until idle --until done --timeout 5000 >/dev/null 2>&1 && ready=1
  done
  sleep 2   # let SessionStart hooks finish their thing and release the prompt
  [ "$ready" = 1 ] || echo "warning: $name did not confirm readiness — check: hive peek $name" >&2

  echo "spawn: $name  ws=$ws pane=$pane model=$MODEL cwd=$cwd"
  echo "sid=$sid"
}

cmd_task() {  # task <name> <brief-file>  |  task <name> - (brief from stdin)
  local name="${1:?usage: hive task <name> <file|->}"; local src="${2:?missing brief}"
  local dir; dir=$(drone_dir "$name")
  [ -f "$(drone_meta "$name")" ] || die "unknown drone: $name"
  local pane; pane=$(pane_of "$name")

  if [ "$src" = "-" ]; then cat > "$dir/brief.md"; else cp "$src" "$dir/brief.md"; fi

  # reporting protocol appended to every brief
  cat >> "$dir/brief.md" <<EOF

---
## Reporting protocol (mandatory)
When the task is finished, WRITE a report to \`$dir/report.md\`:

    STATUS: DONE | BLOCKED | FAILED
    ## Result
    <concise: what you did, what you found out>
    ## Files
    <changed/created paths, or "none">
    ## Issues
    <what went wrong, what you need, or "none">

The report is the only channel to the coordinator — nobody reads your terminal.
Without a written report the task counts as not done.
If you get stuck or need something: write a report with STATUS: BLOCKED and describe what you need.
EOF

  rm -f "$dir/report.md"

  local msg="Read $dir/brief.md and carry out the task it describes."
  # 'done' = the previous turn finished. Remember the pre-send state so a stale 'done'
  # cannot masquerade as delivery of the new task.
  local pre; pre=$(pane_status "$pane")
  [ "$pre" = dead ] && die "drone $name is dead"
  if [ "$pre" = working ]; then
    # Drone mid-turn: Claude Code queues the message, so deliver once and do not retry
    # (a retry would push the task into the queue a SECOND time).
    herdr agent prompt "$name" "$msg" >/dev/null 2>&1 || die "failed to send the task to $name"
    echo "task: $name is working — task queued, will run after the current turn"
    return 0
  fi

  local pending; pending=$(prompt_pending "$pane")
  [ -n "$pending" ] && die "drone $name has unsent text in its prompt: \"$pending\"
Not sending — Enter would send THAT, not my task. Sort the prompt out (hive clear $name) and retry."

  # herdr 0.8: agent prompt appends Enter atomically, and rejects a drone stuck at a dialog
  # (agent_blocked) without sending anything. Delivery is still CONFIRMED via status —
  # a freshly started drone can still lose its first input (SessionStart hooks clear the prompt).
  local attempt i st out
  for attempt in 1 2 3; do
    out=$(herdr agent prompt "$name" "$msg" 2>&1) || {
      case "$out" in
        *agent_blocked*) die "drone $name is stuck at a dialog — check: hive peek $name" ;;
        *) die "failed to send the task to $name: $out" ;;
      esac
    }
    for i in 1 2 3 4 5 6; do
      sleep 2
      st=$(pane_status "$pane")
      [ "$st" = working ] && { echo "task: $name <- $dir/brief.md (attempt $attempt)"; return 0; }
      # A fast drone finishes the whole job between polls: report.md (deleted before
      # sending) is hard proof of delivery; 'done' only counts when fresh.
      [ -f "$dir/report.md" ] && { echo "task: $name <- $dir/brief.md (attempt $attempt, fast finish)"; return 0; }
      [ "$st" = done ] && [ "$pre" != done ] && { echo "task: $name <- $dir/brief.md (attempt $attempt)"; return 0; }
      [ "$st" = dead ] && die "drone $name is dead"
    done
  done
  echo "task: $name — SENT but the drone did not start (status: $(pane_status "$pane")). Check: hive peek $name" >&2
  return 1
}

cmd_clear() {  # clear <name> — clears the drone's input field (ctrl+u)
  local name="${1:?usage: hive clear <name>}"
  local pane; pane=$(pane_of "$name") || die "unknown drone: $name"
  local pending; pending=$(prompt_pending "$pane")
  [ -z "$pending" ] && { echo "clear: $name — prompt already clean"; return 0; }
  echo "clear: $name — removing from the prompt: \"$pending\""
  herdr pane send-keys "$pane" ctrl+u >/dev/null 2>&1
  sleep 1
  local still; still=$(prompt_pending "$pane")
  [ -n "$still" ] && die "failed to clear the prompt (left over: \"$still\")"
  echo "clear: $name — clean"
}

cmd_say() {  # say <name> <text> — ad-hoc message to a drone
  local name="${1:?usage: hive say <name> <text>}"; shift
  local pane; pane=$(pane_of "$name") || die "unknown drone: $name"
  local pending; pending=$(prompt_pending "$pane")
  [ -n "$pending" ] && die "drone $name has unsent text in its prompt: \"$pending\"
Not sending — Enter would send THAT. Sort the prompt out (hive clear $name) and retry."
  local out
  out=$(herdr agent prompt "$name" "$*" 2>&1) || case "$out" in
    *agent_blocked*) die "drone $name is stuck at a dialog — check: hive peek $name" ;;
    *) die "failed to send to $name: $out" ;;
  esac
  echo "say: $name <- $*"
}

cmd_status() {  # status [name...] — never blocks
  local names=()
  if [ $# -gt 0 ]; then names=("$@"); else
    for d in "$DRONES_DIR"/*/; do [ -d "$d" ] && names+=("$(basename "$d")"); done
  fi
  [ ${#names[@]} -eq 0 ] && { echo "no drones"; return; }
  printf '%-16s %-8s %-10s %-9s %s\n' DRONE PANE STATUS REPORT TASK
  local n pane st rep brief
  for n in "${names[@]}"; do
    pane=$(pane_of "$n" 2>/dev/null) || pane="-"
    st=$(pane_status "$pane")
    if [ -f "$(drone_dir "$n")/report.md" ]; then
      rep=$(grep -m1 -oE 'DONE|BLOCKED|FAILED' "$(drone_dir "$n")/report.md" 2>/dev/null || echo "present")
    else rep="-"; fi
    brief=$(head -1 "$(drone_dir "$n")/brief.md" 2>/dev/null | cut -c1-40)
    printf '%-16s %-8s %-10s %-9s %s\n' "$n" "$pane" "$st" "$rep" "${brief:--}"
  done
}

cmd_wait() {  # wait [name...] [--timeout SEC] — ends on report/blocked, has a hard limit
  local timeout=300 names=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout="$2"; shift 2 ;;
      *) names+=("$1"); shift ;;
    esac
  done
  if [ ${#names[@]} -eq 0 ]; then
    for d in "$DRONES_DIR"/*/; do [ -d "$d" ] && names+=("$(basename "$d")"); done
  fi
  local start; start=$(date +%s)
  local n pane st done_all elapsed
  while :; do
    done_all=1
    for n in "${names[@]}"; do
      [ -f "$(drone_dir "$n")/report.md" ] && continue      # report = finished
      pane=$(pane_of "$n" 2>/dev/null) || continue
      st=$(pane_status "$pane")
      case "$st" in
        blocked|dead) continue ;;                            # also finished, just badly
        done)
          # turn over; the report might not be flushed yet — give it a moment
          sleep 3
          [ -f "$(drone_dir "$n")/report.md" ] || echo "wait: $n finished a turn WITHOUT a report" >&2
          continue ;;
        *) done_all=0 ;;
      esac
    done
    elapsed=$(( $(date +%s) - start ))
    [ "$done_all" = 1 ] && break
    [ "$elapsed" -ge "$timeout" ] && { echo "wait: ${timeout}s limit reached"; break; }
    sleep 5
  done
  cmd_status "${names[@]}"
}

cmd_send() {  # send <to> <subject> [--body TEXT]  (without --body: body from stdin, optional)
  local to="${1:?usage: hive send <to|all> <subject> [--body TEXT]}"; shift
  local subject="${1:?missing subject}"; shift
  local body=""
  case "${1:-}" in
    --body) body="${2:-}" ;;
    *) [ -t 0 ] || body=$(cat) ;;
  esac
  local from="${HIVE_DRONE:-coord}"

  local -a targets=()
  if [ "$to" = all ]; then
    for d in "$DRONES_DIR"/*/; do
      [ -d "$d" ] || continue
      local n; n=$(basename "$d"); [ "$n" = "$from" ] || targets+=("$n")
    done
    [ "$from" = coord ] || targets+=(coord)
  else
    targets=("$to")
  fi
  [ ${#targets[@]} -eq 0 ] && { echo "send: no recipients"; return 0; }

  local t
  for t in "${targets[@]}"; do
    mailbox_put "$from" "$t" "${KIND:-msg}" "$subject" "$body" || continue
    wake_recipient "$t"
    echo "send: $from -> $t: $subject"
  done
}

cmd_inbox() {  # inbox [who] [--keep] — reads and consumes a mailbox (own by default)
  local who="" keep=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep) keep=1; shift ;;
      *) who="$1"; shift ;;
    esac
  done
  [ -n "$who" ] || who="${HIVE_DRONE:-coord}"
  local box="$MAIL_DIR/$who"
  mkdir -p "$box"

  local -a msgs=()
  while IFS= read -r f; do msgs+=("$f"); done < <(find "$box" -maxdepth 1 -name '*.json' | sort)
  if [ ${#msgs[@]} -eq 0 ]; then
    echo "inbox ($who): empty"; rm -f "$HIVE_DIR/.wake-$who"; return 0
  fi

  python3 -c "
import json,sys
for p in sys.argv[1:]:
    try: e=json.load(open(p))
    except Exception: continue
    kind={'decision':'DECISION','done':'finished'}.get(e.get('kind'),'message')
    print(f\"── {e.get('ts','?')}  from: {e.get('from','?')}  [{kind}]\")
    print(f\"   {e.get('subject','')}\")
    b=(e.get('body') or '').strip()
    if b:
        for line in b.splitlines(): print(f\"   | {line}\")
" "${msgs[@]}"

  if [ "$keep" = 0 ]; then
    mkdir -p "$MAIL_DIR/.archive"
    mv "${msgs[@]}" "$MAIL_DIR/.archive/" 2>/dev/null
    rm -f "$HIVE_DIR/.wake-$who"   # release the wake-up — the next batch may wake again
  fi
}

cmd_report() {  # report <name>
  local name="${1:?usage: hive report <name>}"
  local f; f="$(drone_dir "$name")/report.md"
  [ -f "$f" ] || { echo "no report from $name (status: $(pane_status "$(pane_of "$name")"))"; return 1; }
  cat "$f"
}

cmd_peek() {  # peek <name> [lines] — view of the drone's terminal
  local name="${1:?usage: hive peek <name> [lines]}"; local lines="${2:-40}"
  local pane; pane=$(pane_of "$name") || die "unknown drone: $name"
  herdr pane read "$pane" --source visible --lines "$lines" 2>/dev/null \
    || die "failed to read the pane"
}

cmd_mute() {  # mute <name> [--off] — silences the drone's automatic wake-ups
  local name="${1:?usage: hive mute <name> [--off]}"
  local dir; dir=$(drone_dir "$name")
  [ -d "$dir" ] || die "unknown drone: $name"
  if [ "${2:-}" = "--off" ]; then
    rm -f "$dir/.mute"; echo "mute: $name — wake-ups enabled again"
  else
    : > "$dir/.mute"
    echo "mute: $name — Stop/Notification hooks silenced (use for a conversational drone"
    echo "      the human talks to directly; 'hive send coord' from the drone still works)"
  fi
}

cmd_kill() {  # kill <name> [--purge]
  local name="${1:?usage: hive kill <name> [--purge]}"; local purge="${2:-}"
  local ws; ws=$(meta_get "$name" workspace_id) || die "unknown drone: $name"
  herdr workspace close "$ws" >/dev/null 2>&1
  rm -f "$HIVE_DIR/.wake-$name"
  if [ "$purge" = "--purge" ]; then
    rm -rf "$(drone_dir "$name")" "$MAIL_DIR/$name"
    echo "kill: $name (removed along with mailbox and history)"
  else echo "kill: $name (workspace $ws closed, report kept)"; fi
}

cmd_rename() {  # rename <old> <new>
  local old="${1:?usage: hive rename <old> <new>}"; local new="${2:?missing new name}"
  [[ "$new" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] \
    || die "name '$new' rejected: herdr requires [a-z][a-z0-9_-]{0,31}"
  local ws pane; ws=$(meta_get "$old" workspace_id) || die "unknown drone: $old"
  pane=$(pane_of "$old")
  herdr workspace rename "$ws" "$new" >/dev/null 2>&1
  herdr agent rename "$pane" "$new" >/dev/null 2>&1
  mv "$(drone_dir "$old")" "$(drone_dir "$new")"
  python3 -c "
import json
p='$(drone_dir "$new")/meta.json'
d=json.load(open(p)); d['name']='$new'; json.dump(d,open(p,'w'),indent=1)"
  echo "rename: $old -> $new"
}

cmd_revive() {  # revive <name> — resurrects a drone with its conversation history intact
  local name="${1:?usage: hive revive <name>}"
  local cwd; cwd=$(meta_get "$name" cwd) || die "unknown drone: $name"
  local ws; ws=$(meta_get "$name" workspace_id)
  herdr workspace close "$ws" >/dev/null 2>&1
  cmd_spawn "$name" --cwd "$cwd" --resume
}

case "${1:-}" in
  spawn)  shift; cmd_spawn  "$@" ;;
  task)   shift; cmd_task   "$@" ;;
  say)    shift; cmd_say    "$@" ;;
  clear)  shift; cmd_clear  "$@" ;;
  send)   shift; cmd_send   "$@" ;;
  inbox)  shift; cmd_inbox  "$@" ;;
  coord)  herdr pane current --current 2>/dev/null | jqp "print(r['pane']['pane_id'])" > "$HIVE_DIR/coord.pane"
          echo "coord: $(coord_pane)" ;;
  _pending) shift; prompt_pending "${1:?missing pane}" ;;   # internal, for drone-ping.sh
  status) shift; cmd_status "$@" ;;
  wait)   shift; cmd_wait   "$@" ;;
  report) shift; cmd_report "$@" ;;
  mute)   shift; cmd_mute   "$@" ;;
  peek)   shift; cmd_peek   "$@" ;;
  kill)   shift; cmd_kill   "$@" ;;
  rename) shift; cmd_rename "$@" ;;
  revive) shift; cmd_revive "$@" ;;
  *) cat <<'EOF'
hive — command a swarm of Claude Code agents in herdr

  hive spawn  <name> [--cwd PATH]    new drone (opus, skip-permissions, own workspace)
  hive task   <name> <file|->        send a brief (file or stdin) + report protocol
  hive say    <name> <text>          ad-hoc message to a drone
  hive clear  <name>                 clear the drone's input field (when foreign text hangs there)
  hive send   <to> <subject> [--body T] swarm mail (to: coord | drone | all) + recipient wake-up
  hive inbox  [who] [--keep]         read and consume a mailbox (own by default)
  hive coord                         register the current pane as the coordinator pane
  hive status [name]                 swarm state table (never blocks)
  hive wait   [names] [--timeout S]  wait for reports, hard limit (default 300s)
  hive report <name>                 show a drone's report
  hive mute   <name> [--off]         silence automatic wake-ups (conversational drone)
  hive peek   <name> [lines]         view of the drone's terminal
  hive kill   <name> [--purge]       kill a drone
  hive rename <old> <new>            rename a drone and its workspace
  hive revive <name>                 resurrect a drone with its history (--resume)

Model: $HIVE_MODEL (default opus).  Data: ~/.herdr-hive/drones/<name>/
EOF
  ;;
esac
